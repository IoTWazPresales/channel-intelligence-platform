# Leave unset so the browser uses same-origin `/api/v1/...` (Next.js route proxies to FastAPI — see
# `src/app/api/v1/[[...path]]/route.ts`). In Docker web, use `CIP_ENABLE_NEXT_API_PROXY` + `CIP_API_INTERNAL_URL`.
#
# Only set this when the UI must talk to the API on another origin (cross-origin; FastAPI needs API_CORS_ORIGINS).
# NEXT_PUBLIC_API_URL=http://localhost:8010
