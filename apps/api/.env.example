# Copy to `.env` in this folder for local overrides (optional).
# Defaults match Docker Postgres/Redis on localhost — see `infra/env.example` for full list.

DATABASE_URL=postgresql+asyncpg://cip:cip@localhost:5432/cip
DATABASE_URL_SYNC=postgresql://cip:cip@localhost:5432/cip
# Optional (local dev only): Alembic uses this when set, instead of DATABASE_URL_SYNC. Use when migrations fail
# with "must be owner of table ..." because schema was created under another role (e.g. postgres). Remove after
# upgrade head succeeds so the app keeps using DATABASE_URL_SYNC as the app role.
# DATABASE_URL_SYNC_MIGRATE=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cip
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Local dev without Redis/Celery: Product Master background commit runs in an API daemon thread (explicit opt-in).
# Values: broker | in_process_thread. Never use in_process_thread in production.
# Full audit: ../../docs/ASYNC_AND_BROKER_PATHS.md (from repo root: docs/ASYNC_AND_BROKER_PATHS.md)
# CIP_DEV_CELERY_DISPATCH=in_process_thread
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/uploads
# Local dev port contract for this repo: API on 8001 (web remains on 3000).
CIP_API_PORT=8001
