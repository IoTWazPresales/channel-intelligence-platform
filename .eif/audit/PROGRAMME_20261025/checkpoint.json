  "decisions": {
    "D-0116": {
      "id": "D-0116",
      "scope": "N-0115",
      "statement": "N-0115 proposed for Warren: Day grain: allow day only on models dated by day (DSI, shipments, returns, CPOR) and only on the v2 endpoint, v1 keeps refusing day; alternative keep week as the lowest grain everywhere.",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0117": {
      "id": "D-0117",
      "scope": "N-0115",
      "statement": "N-0115 proposed for Warren: DSI sales value = units x unit price ex VAT on priced rows only, with priced-units coverage, currency not recorded, never SUM(revenue) (22,546 of 58,128 rows have no price; currency NULL on all rows).",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0118": {
      "id": "D-0118",
      "scope": "N-0115",
      "statement": "N-0115 proposed for Warren: CST sales value converted to the tenant sales-value VAT setting per row vat_basis exactly as the sell-through overview does; no listing-price estimate for unpriced units.",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0119": {
      "id": "D-0119",
      "scope": "N-0115",
      "statement": "N-0115 proposed for Warren: Distributor reported stock by period = latest count per distributor and product in each bucket, no carry-forward, shown with pairs reporting; Channel Ops derived stock and weeks of cover stay governed and keep refusing period.",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0120": {
      "id": "D-0120",
      "scope": "N-0115",
      "statement": "N-0115 proposed for Warren: Shipments period date = ship confirm date; alternative POD date (landed).",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0121": {
      "id": "D-0121",
      "scope": "N-0114",
      "statement": "N-0114 proposed for Warren: chart numbers keep the existing convention, decimal point and a space for thousands (R 1.2 M, US$ 1.2 M), not a decimal comma; USD is shown as US$ on charts, tiles and table headers (text only).",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0122": {
      "id": "D-0122",
      "scope": "N-0114",
      "statement": "N-0114 proposed for Warren: bars and pies drop the folded Other (n) bucket in favour of a viewer-set top N with a Top 10 of 37 caption; pie shares are of the full total; series charts keep the 7-series colour cap with Other. Alternatives: keep the Other fold when top N is not All, or offer Other as a toggle.",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0123": {
      "id": "D-0123",
      "scope": "N-0115",
      "statement": "N-0115 proposed for Warren: CPOR open = cases that are not superseded and whose workflow_status is not in a closed set (settled, ended, cancelled, rejected, voided), as the portfolio service excludes; CPOR value = support USD (ttl_support_usd, the compute currency) with ZAR shown beside it. Alternatives: status column instead of workflow_status; estimate value instead of support.",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0124": {
      "id": "D-0124",
      "scope": "N-0115",
      "statement": "N-0115 proposed for Warren: per-customer stock cover and restock flags on the starter dashboards reuse the sell-through code definitions if they exist (per-customer replenishment weeks of cover setting); if not, the widget shows reported on-hand beside per-week sell-through and no derived cover number.",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0125": {
      "id": "D-0125",
      "scope": "N-0116",
      "statement": "N-0116 proposed for Warren: Storage: one nullable definition_v2 JSONB on dashboard_widget and saved_report (query + display; NULL = v1 path), dashboard.filters_json and template_key; alternatives query_v2 + display_v2 or a version int.",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0126": {
      "id": "D-0126",
      "scope": "N-0116",
      "statement": "N-0116 proposed for Warren: Migration 0048 and the definition script run on the clone (rolled back) and cip_test only; applying them to cip waits for Warren's go (dual path: not migrating is safe).",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0127": {
      "id": "D-0127",
      "scope": "N-0116",
      "statement": "N-0116 proposed for Warren: Starter B is titled Sell-through & stock across customers (no stock-cover figure exists yet); the mandate's title needs decision 5 first.",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0128": {
      "id": "D-0128",
      "scope": "N-0116",
      "statement": "N-0116 proposed for Warren: Business unit in the filter bar = product line (bu), what v1 widgets use; dim_product.business_unit stays an attribute.",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0129": {
      "id": "D-0129",
      "scope": "N-0116",
      "statement": "N-0116 proposed for Warren: Compare previous year = both dates minus one calendar year; alternative 52 weeks (keeps Monday weeks aligned).",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0130": {
      "id": "D-0130",
      "scope": "N-0116",
      "statement": "N-0116 proposed for Warren: Real-data screenshots of the starters: the agent does not sign in, so starters are rendered on design-lab fixtures shaped like v2 responses; alternative grant the app role on a cip clone and run an API on it.",
      "origin": "eif",
      "status": "proposed",
      "supersedes": null
    },
    "D-0131": {
      "id": "D-0131",
      "scope": "N-0116",
      "statement": "Warren 2026-10-24: The original 23 October overnight specification remains the authoritative functional scope. Claude's temporary scope reductions are not accepted as permanent deferrals. Proceed autonomously with authorised development, testing and EIF updates. Production database migration and deployment remain explicitly unauthorised. No operator acceptance is granted for incomplete nodes. Source: N0116_OPERATOR_EXECUTION.md, current direct operator instruction.",
      "origin": "operator",
      "status": "accepted",
      "supersedes": null
    }
