# API
DATABASE_URL=postgresql+asyncpg://cip:cip@localhost:5432/cip
DATABASE_URL_SYNC=postgresql://cip:cip@localhost:5432/cip
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Optional (Windows / no Redis): CIP_DEV_CELERY_DISPATCH=in_process_thread — see docs/LOCAL_DEV_WINDOWS.md
API_CORS_ORIGINS=http://localhost:3000
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/uploads
# Optional S3-compatible (production)
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Web (Next.js public)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Promo plan exports (optional email; manual download is default)
# PROMO_EXPORT_EMAIL_ENABLED=false
# PROMO_EXPORT_DEFAULT_RECIPIENT=
